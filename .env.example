# Admin UI login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=horseshoe
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Agent / Grok-bot HTTP API
AGENT_API_KEY=hco-agent-dev-key

# AgentMail — contact + booking notifications into Josh's monitored inbox
# Create a Josh-org API key at https://console.agentmail.to that can send as hsc-notify@physhlab.com
# (or use an HSC service-org key that can send as hscapp2@agentmail.to).
# Never expose the key to the browser.
AGENTMAIL_API_KEY=am_...
# NOTIFY (From) MUST differ from AGENT (To). Send-to-self lands as `sent` not
# `received`/`unread`, so Josh's monitoring agent misses it.
# Prefer hsc-notify@ with a Josh-org key; hscapp2@agentmail.to works with the service key.
AGENTMAIL_NOTIFY_INBOX=hsc-notify@physhlab.com
AGENTMAIL_AGENT_INBOX=jjammer@physhlab.com

# Vercel Preview: disable floating Toolbar / feedback circle
# Set this in the Vercel project Preview environment (Dashboard → Settings → Environment Variables)
# or turn Toolbar Preview to Off under Project Settings → General → Vercel Toolbar.
VERCEL_PREVIEW_FEEDBACK_ENABLED=0
